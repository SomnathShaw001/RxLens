# Server Config
PROJECT_NAME="RxLens Backend API"
VERSION="1.0.0"
API_V1_STR="/v1"
ENVIRONMENT="development"
PORT=8000

# Database (PostgreSQL with pgvector, e.g. Supabase or Local Docker)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/rxlens"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rxlens"

# Redis & Queue
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_BACKEND="local" # "local" or "supabase" or "s3"
LOCAL_STORAGE_DIR="./uploads"
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="prescriptions"

# Google Gemini API (Multimodal OCR & Extraction)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Firebase Auth
FIREBASE_PROJECT_ID=""
FIREBASE_CREDENTIALS_PATH="" # Path to serviceAccountKey.json if running locally

# Security & JWT
JWT_SECRET="temporary-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
